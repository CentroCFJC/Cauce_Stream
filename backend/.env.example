# Application
DATABASE_URL=postgresql+asyncpg://cauce:cauce@localhost:5432/cauce

# Environment: development | testing | production
APP_ENV=development
DEBUG=true

# CORS: comma-separated origins (empty = CORS disabled)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Auth: local JWT signing (use a long random value; mandatory in production)
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# Bootstrap administrator: created by the seed only while no ADMINISTRADOR
# user exists. All user passwords are 4-digit numeric PINs.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=0000

# Shared secret between this server and every Cauce Stream client
# (X-Device-Key header on the heartbeat, the playback WebSocket and the
# media file download). Empty = device authentication disabled.
# Use a long random value and configure the SAME value on all clients.
CAUCE_DEVICE_SECRET=

# Devices: offline after N seconds without heartbeat; sweep every N seconds
DEVICE_OFFLINE_AFTER_SECONDS=30
DEVICE_SWEEP_INTERVAL_SECONDS=10

# Autoconfig: a pending discovery expires after N seconds without heartbeats
AUTOCONFIG_PENDING_TTL_SECONDS=30

# Media storage (RF-008): root directory for uploaded binaries.
# - Empty: stable default <backend>/data/media (independent of CWD)
# - Absolute path wins: Docker uses /app/data/media with a mounted volume
CAUCE_MEDIA_DIR=
# Maximum accepted upload size in MB
CAUCE_MEDIA_MAX_SIZE_MB=200
